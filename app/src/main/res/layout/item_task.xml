<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@color/white">

    <CheckBox android:id="@+id/cbTask"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:buttonTint="@color/primary_blue"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvTaskName"
            android:textSize="15sp" android:textColor="@color/text_dark"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvTaskMeta"
            android:textSize="12sp" android:textColor="@color/text_gray"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
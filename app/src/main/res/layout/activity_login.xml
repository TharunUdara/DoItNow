<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/white">

    <TextView android:text="Login"
        android:textSize="32sp" android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="60dp"/>

    <TextView android:text="Welcome back to DoItNow."
        android:textSize="14sp" android:textColor="@color/text_gray"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>

    <TextView android:text="USERNAME"
        android:textSize="11sp" android:textColor="@color/text_gray"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="40dp"/>

    <EditText android:id="@+id/etUsername"
        android:hint="Enter your username"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@drawable/bg_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

    <TextView android:text="PASSWORD"
        android:textSize="11sp" android:textColor="@color/text_gray"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>

    <EditText android:id="@+id/etPassword"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@drawable/bg_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

    <Button android:id="@+id/btnLogin"
        android:text="Login"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/primary_blue"
        android:textColor="@color/white"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <TextView android:text="Don't have an account? "
            android:textColor="@color/text_gray"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvSignUp" android:text="Sign up"
            android:textColor="@color/primary_blue"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>